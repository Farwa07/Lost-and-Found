PORT=4230
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# Frontend URL (used in reset-password emails and allowed by CORS)
FRONTEND_URL=http://localhost:5173
# Optional extra allowed origins, comma separated
CORS_ORIGINS=

# Used only once, to create the first admin when no admin exists yet.
# Password must have 8+ chars with upper, lower, number and special character.
ADMIN_EMAIL=
ADMIN_PASSWORD=
